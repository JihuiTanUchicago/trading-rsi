[Unit]
Description=Daily rules map + scoreboard for the PAPER implication-lag catcher (app.implication_map_run): public market data and one LLM read per changed topic cluster, no orders; results to S3 research-watch/implication/. Runs on the WEB box.
After=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/opt/kalshi
Nice=15
MemoryMax=1G
TimeoutStartSec=3h
ExecStart=/bin/bash -c 'set -a; . /opt/kalshi/.env.aws; . /opt/kalshi/.env.app; set +a; unset AWS_PROFILE; exec /opt/kalshi/.venv313/bin/python -u -m app.implication_map_run >> /opt/kalshi/logs/implication_map.log 2>&1'
