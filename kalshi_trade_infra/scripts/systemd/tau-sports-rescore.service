[Unit]
Description=One-off re-score of the gated sports ideas from runs 2622 and 2646 on the leaky vs fixed backtest (app.sports_rescore_run, PR #839): read-only, no gate, no holdout; result to S3 research-watch/dumps/. Runs on the WEB box.
After=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/opt/kalshi
Nice=15
MemoryMax=2500M
TimeoutStartSec=1h
ExecStart=/bin/bash -c 'set -a; . /opt/kalshi/.env.aws; . /opt/kalshi/.env.app; set +a; unset AWS_PROFILE; exec /opt/kalshi/.venv313/bin/python -u -m app.sports_rescore_run >> /opt/kalshi/logs/sports_rescore.log 2>&1'
