[Unit]
Description=Bitcoin maker pilot (app.btc_maker_pilot_run): the lab's confirmed KXBTC policy on live books. DRY RUN by default (public reads, a shadow venue that never sends an order). LIVE only with TAU_BTC_MAKER_PILOT_ENABLED=1, TAU_BTC_MAKER_PILOT_DRY_RUN=0 and APP_LIVE_TRADING_ENABLED=1, capped by a loss stop and a collateral cap. Each run ends 2 min after an hourly close and cancels its orders on start and stop.
After=network-online.target
[Service]
Type=simple
WorkingDirectory=/opt/kalshi
MemoryMax=512M
TimeoutStopSec=90
# Todd 2026-11-24 23:43Z approved live at size 10 with ~$250, but cannot deposit. On 2026-11-25 00:10Z
# (card "Split the cash now") he chose: $20 moves out of the mention pilot's cash today, and the maker
# runs live at size 3 with a $10 loss stop; the mention pilot keeps ~$15. The $20 moves once from
# shard 0 to the crypto shard; until it is there each run only waits.
# 2026-11-25 02:25Z: live cancels on the crypto shard did not take (an unrouted DELETE goes to shard 0 and
# answers 404 while the order keeps resting on shard 2), so repriced orders stacked: one contract reached
# 60 NO / 39 YES against max_inventory 3. Back to dry run (#880), then live again on Todd's approved size
# with cancels routed by market_ticker, a probe Kalshi must read back as canceled, and a stop for good if
# any contract passes 2x the size cap.
# Off switch: TAU_BTC_MAKER_PILOT_ENABLED=0 in /opt/kalshi/.env.app (sourced after these, so it wins).
Environment=TAU_BTC_MAKER_PILOT_ENABLED=1
Environment=TAU_BTC_MAKER_PILOT_DRY_RUN=0
Environment=TAU_BTC_MAKER_PILOT_MAX_INVENTORY=3
Environment=TAU_BTC_MAKER_PILOT_QUOTE_SIZE=3
Environment=TAU_BTC_MAKER_PILOT_LOSS_STOP=10
Environment=TAU_BTC_MAKER_PILOT_COLLATERAL_CAP=18
Environment=TAU_BTC_MAKER_PILOT_FUND_USD=20
Environment=TAU_BTC_MAKER_PILOT_KEEP_ON_SHARD0=12
KillSignal=SIGTERM
ExecStart=/bin/bash -c 'set -a; . /opt/kalshi/.env.aws; . /opt/kalshi/.env.app; set +a; unset AWS_PROFILE; exec /opt/kalshi/.venv313/bin/python -u -m app.btc_maker_pilot_run >> /opt/kalshi/logs/btc_maker_pilot.log 2>&1'
