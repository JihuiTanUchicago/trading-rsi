[Unit]
Description=One-off, one-time holdout look at the weather-low maker lead that passed validation (app.maker_scan_run --holdout); refuses if a holdout report exists; S3 research-watch/maker-scan/holdout/. Runs on the WEB box.
After=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/opt/kalshi
Nice=15
MemoryMax=1500M
TimeoutStartSec=2h
ExecStart=/bin/bash -c 'set -a; . /opt/kalshi/.env.aws; . /opt/kalshi/.env.app; set +a; unset AWS_PROFILE; exec /opt/kalshi/.venv313/bin/python -u -m app.maker_scan_run --holdout >> /opt/kalshi/logs/maker_holdout.log 2>&1'
